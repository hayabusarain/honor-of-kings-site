# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# 作業用フォルダ（中間生成物・OCR素材。追跡しない）
data_processing/
scratch/
Patch */
*.traineddata

# Python
__pycache__/
*.py[cod]

# 一時ログ・監査出力
audit_results.txt
eslint_output.txt
eslint_report.json
chicha.txt
mulan.txt
zhangfei_check*.txt

# バックアップファイル
*.bak
*.bak[0-9]
en_backup.json

# Credentials（鍵の実体は絶対にコミットしない。置き方は README を参照）
config/credentials/*
!config/credentials/README.md

# 過去に直下へ置かれて漏洩した鍵ファイル名。再発防止のため明示的に除外する。
key.json
client_secret.json
