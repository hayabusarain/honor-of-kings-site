  "504": {
    "hero_name": "Milady",
    "skills": [
      {
        "skill_name": "Mechanical Minions",
        "cd": "0",
        "mana_cost": "0",
        "tags": "Summon, Damage",
        "description": "When Milady defeats an enemy, a mechanical minion is summoned to automatically attack other enemies for 6s. At the end of their duration, minions merge with another nearby minion of the same level and upgrade themselves (up to a max of Lvl 3). If there are no suitable minions to merge with, they self-destruct, dealing 200 (200 + 30% magical attack) magical damage (explosion radius increases with minion level).\nMinion Basic Attack: 120 (120 + 25% magical attack) magical damage. Health: 500 (500 + 110% magical attack).\nMovement Speed: 450 (450 + 10% magical attack).\nMinions deal 75% damage to structures. Merging increases Basic Attack and self-destruction damage by 30%, and max Health by 20%.\nUp to 4/2/1 minion(s) can exist at the same time. Once exceeding the limit, older minions will attempt to merge or self-destruct."
      },
      {
        "skill_name": "Air Superiority",
        "cd": "8s",
        "mana_cost": "50",
        "tags": "Damage, Slow",
        "description": "Milady commands an aircraft to fly in the target direction, attacking the enemy nearest to it multiple times along its path. Each attack deals 65 (65 + 10% magical attack) magical damage. After every two attacks, the aircraft attacks the nearest target an extra time, dealing 140 (140 + 20% magical attack) magical damage.\nUsing this skill again during flight splits the aircraft into two smaller aircraft. Each attacks the enemy nearest to it multiple times, dealing 65 (65 + 10% magical attack) magical damage. Enemies attacked by both aircraft have their Movement Speed reduced by 25% for 1.5s."
      },
      {
        "skill_name": "Forced Invasion",
        "cd": "3s",
        "mana_cost": "25",
        "tags": "Summon, Damage",
        "description": "Milady airdrops 2 mechanical minions in the target location, dealing 100 (100 + 20% magical attack) magical damage to nearby enemies upon landing. The mechanical minions activate after a 1s delay to search for the nearest enemy to attack.\nShe stocks 1 charge of this skill every 12-15s (affected by Cooldown Reduction), up to 3 charges."
      },
      {
        "skill_name": "Chaos Field",
        "cd": "30s",
        "mana_cost": "100",
        "tags": "Crowd Control, Slow, Damage",
        "description": "Milady fires a signal device at a target enemy or structure, marking it for 3s. Non-structure units are stunned for 0.75s. While marked, the target takes 80 (80 + 4% magical attack) magical damage every 0.5s and is slowed by 15%. When the mark expires, it explodes, dealing magical damage to the target and nearby enemies, equal to 25% of the total damage taken during the mark's duration.\nIf the target dies while marked, immediately summons 3 mechanical minions. While the Ultimate is active, allied mechanical minions in range gain 100% Attack Speed and Movement Speed, and will rush to attack the marked target.\nCan be used on structures, but does not stun them."
      }
    ],
    "meta": {
      "summoner_spells": [
        "閃現"
      ],
      "synergy": [
        {
          "hero_name": "孫臏",
          "reason": "Compensates for the lack of mobility with speed buffs, facilitating smooth tower sieges with summoned bots.",
          "hero_id": "118"
        },
        {
          "hero_name": "張飛",
          "reason": "Peels enemies away, creating a safe environment for Milady to summon bots and land her ultimate.",
          "hero_id": "171"
        }
      ],
      "counters": [
        {
          "hero_name": "不知火舞",
          "reason": "Ignores the bots and uses high mobility to quickly close the gap and instantly burst them down.",
          "hero_id": "157"
        },
        {
          "hero_name": "子牙",
          "reason": "Can easily wipe out entire armies of painstakingly summoned bots with wide AoE skills.",
          "hero_id": "148"
        }
      ],
      "skill_order": {
