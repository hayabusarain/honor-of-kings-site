  "582": {
    "name": "Flowborn (Mage)",
    "skills": [
      {
        "skill_name": "Flow of the World",
        "cd": "",
        "mana_cost": "",
        "tags": "Switch, Damage",
        "description": "Flowborn can draw the Flow into their body at the Base to enhance stats (increases with level). Vitality: Increases Magical Attack by 50 and max Health by 300. Piercing Heart: Increases Magical Attack by 50 and Magical Pierce by 50. Haste: Increases Magical Attack by 50 and Movement Speed by 3.5%. Focus: Increases Magical Attack by 50 and Cooldown Reduction by 5%. Can spend 1 stack of Flow to perform an enhanced Basic Attack that deals 60 (60 + 12% AP) magical damage to enemies within range."
      },
      {
        "skill_name": "Convergence",
        "cd": "12.5s",
        "mana_cost": "50",
        "tags": "Enhance, Recovery, Knock Back",
        "description": "Flowborn channels the Flow, reducing the cooldown of other skills by 50% while gaining 5 stacks of Flow and recovering 150 (150 + 4% extra max Health) Health. Gains 1 extra stack and recovers extra Health for every teammate and every 2 minions nearby, for up to 9 stacks and double the recovery. Flowborn deals 100 (100 + 20% AP) magical damage to nearby enemies and knocks them back (without applying crowd control)."
      },
      {
        "skill_name": "Flow Formation",
        "cd": "7.5s",
        "mana_cost": "40",
        "tags": "Crowd Control, Damage",
        "description": "Flowborn controls the nearby Flow and conjures a magic circle, dealing 325 (325 + 65% AP) magical damage to enemies within range and slowing them by 30% for 1s. The magic circle deals 65 (65 + 13% AP) magical damage for 1.5s every 0.5s. Can use this skill continuously over 1.5s, with new effects in the following order. Launching Flow: Deals the same damage to enemies and launches them for 0.5s. Stunning Flow: Deals the same damage to enemies and stuns them for 0.5s. If used within the initial magic circle, both additional uses refresh the magic circle's duration and increase damage over time by 50%. Can spend 4 stacks of Flow to use the skill without triggering cooldown. The inner area of all circles inflicts an extra 50% crowd control effect."
      },
      {
        "skill_name": "Arcane Arts",
        "cd": "25s",
        "mana_cost": "70",
        "tags": "Damage",
        "description": "Flowborn channels the Flow into a beam, dealing 700 (700 + 140% AP) magical damage to enemies in its path. The beam will link with an enemy hero within range and continuously unleash Energy Bombs, dealing 350 (350 + 70% AP) magical damage to the area around the target. Can spend 5 stacks of Flow to stop the skill from entering cooldown after this use. Other skills can be used during this skill."
      }
    ],
    "meta": {
      "summoner_spells": [
        "閃現",
        "浄化"
      ],
      "synergy": [
        {
          "hero_name": "張飛",
          "reason": "Locks down enemies with strong CC and shields, guaranteeing the mage can land their full skill combo.",
          "hero_id": "171"
        },
        {
          "hero_name": "廉頗",
          "reason": "Draws enemy aggro on the frontline, creating space to safely output sustained magic damage from a distance.",
          "hero_id": "105"
        }
      ],
      "counters": [
        {
          "hero_name": "鏡",
          "reason": "Closes the gap with overwhelming mobility and bursts them down before they can even cast a skill.",
          "hero_id": "531"
        },
        {
          "hero_name": "張良",
          "reason": "Possesses undodgeable point-and-click hard CC that completely neutralizes all mobility.",
          "hero_id": "156"
        }
      ],
      "skill_order": {
