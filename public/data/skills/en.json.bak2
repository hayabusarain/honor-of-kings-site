  "531": {
    "hero_name": "Jing",
    "skills": [
      {
        "skill_name": "Passive Skill: Lethal Reflections",
        "cd": "None",
        "mana_cost": "None",
        "tags": [
          "Mark",
          "Damage",
          "Cooldown"
        ],
        "description": "Jing and her mirror image apply 2 different types of marks on enemies when they deal damage. If an enemy has both types of mark at the same time, the marks shatter, dealing physical damage equal to 4% of their lost Health and refreshing the cooldown of Reflective Assault and Shattered Illusions. This effect has a cooldown of 5s (2s during the Ultimate). The damage dealt and recovery provided by the mirror image is only 30% of her real body. The farther the image is from her real body, the greater the damage and recovery, up to 80% of the real body. The image only deals 10% of the real body's damage to towers."
      },
      {
        "skill_name": "Skill 1: Reflective Assault",
        "cd": "9s",
        "mana_cost": "50",
        "tags": [
          "Movement",
          "Damage",
          "Slow"
        ],
        "description": "Jing dashes in the target direction, dealing 200 (200 + 100% extra physical attack) physical damage to enemies in her path and slowing them by 15% for 1.5s. Her next Basic Attack is enhanced to deal an extra strike of 50 (50 + 15% extra physical attack) physical damage. If no mirror image is present on the battlefield, one will be created for 2s, which dashes with her and replicates all of her actions except the Ultimate."
      },
      {
        "skill_name": "Skill 2: Shattered Illusions",
        "cd": "8s",
        "mana_cost": "40",
        "tags": [
          "Recovery",
          "Damage",
          "Speed Up"
        ],
        "description": "Jing deals 160 (160 + 85% extra physical attack) physical damage to nearby enemies and gains a 50% Movement Speed boost that diminishes over 1s. Recovers 150 (150 + 2% extra max health) Health for the first enemy hit, and 25% of that value for each additional target hit. If no mirror image is present on the battlefield, one will be created for 2s, which attacks with her and replicates all of her actions except the Ultimate."
      },
      {
        "skill_name": "Skill 3: Dimensional Shift",
        "cd": "0s",
        "mana_cost": "None",
        "tags": [
          "Movement"
        ],
        "description": "Jing and her mirror image switch locations. Stocks 1 charge every 10s, up to 4 charges."
      },
      {
        "skill_name": "Skill 4: Mirror Domain",
        "cd": "40s",
        "mana_cost": "90",
        "tags": [
          "Movement",
          "Immunity",
          "Damage Reduction"
        ],
        "description": "Jing flies forward, pulling enemies along her path with her. When she stops, she opens a Mirror Vortex and immobilizes the enemies at its center for 1s. She and her mirror image then move to either side of the vortex's central axis. While the vortex is present, she recovers 17 (10 + 4% extra physical attack) Health for every 0.05s spent dashing with Dimensional Shift. She gains 1 charge of shift if she deals damage to an enemy. The Mirror Vortex lasts 10s, during which Jing gains 10% damage reduction, but it will disappear if she leaves before then. When the vortex is formed, 8 mirror fragments are generated along its border. When Jing or her mirror image deal damage to an enemy, the nearest mirror fragment will fly at the enemy, dealing 30 + 2% of the target's lost Health physical damage."
      }
    ],
    "meta": {
      "summoner_spells": [
        "Smite"
      ],
      "synergy": [
