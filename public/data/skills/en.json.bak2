  "577": {
    "id": 30,
    "name": "Dyadia",
    "skills": [
      {
        "skill_name": "Melodic Swing",
        "cd": "None",
        "mana_cost": "None",
        "tags": [
          "Movement",
          "Crowd Control",
          "Gold"
        ],
        "description": "Dyadia enhances her next Basic Attack every 7.5-6s (decreases with hero level): She swings toward the enemy, dealing 379 (210 + 100% physical damage + 30% magical damage) magical damage and knocking them back, then jumps back using the momentum. When a teammate receives Blessing of Fate (does not trigger at full Health; Gold halved if used on teammates with more than 50% Health), or an enemy hero is affected by Bitter Reconciliation, she earns an extra 20 Gold and reduces the preparation time of her enhanced Basic Attack by 50%."
      },
      {
        "skill_name": "Heartlink",
        "cd": "12.5s",
        "mana_cost": "50",
        "tags": [
          "Heal",
          "Speed Up",
          "Movement"
        ],
        "description": "Dyadia blesses a teammate with fated bond, restoring 200 (200 + 30% magical damage) Health. For the next 5s, heroes blessed with fated bond gain 30% Movement Speed when they move toward each other. When they come close, Blessing of Fate is triggered, restoring 400 (400 + 60% magical damage) Health to both and maintaining the Movement Speed boost for 2s. If she uses the skill again on a teammate already blessed with fated bond, she will dash to them and instantly trigger Blessing of Fate. The teammate recovers 400 (400 + 60% magical damage) Health and gains 30% Movement Speed for 2s, while Dyadia recovers 400 (400 + 60% magical damage + 8% extra Health) Health. She can use this skill again within 5s. If it is not used again, the cooldown will be reset."
      },
      {
        "skill_name": "Bitter Farewell",
        "cd": "12.5s",
        "mana_cost": "50",
        "tags": [
          "Damage",
          "Crowd Control",
          "Movement"
        ],
        "description": "Dyadia marks an enemy with a bitter bond, exposing them and dealing 45 (45 + 6% magical damage) magical damage while penalizing them with a loss of 2 Gold (does not affect non-hero units) every second for 5s. When the effect ends, it deals an extra 225 (225 + 30% magical damage) magical damage. When two enemies with bitter bond move toward each other, they are slowed by 25%. When they come close, Bitter Reconciliation is triggered, stopping them from taking more damage and returning the penalized Gold. If she uses the skill again on a target already affected by bitter bond, she will dash to them, triggering Bitter Reconciliation, immobilizing them for 0.75s and dealing a total of 600 (600 + 80% magical damage) magical damage. During this time, she takes 25% less damage (this effect is doubled against the affected target). The penalized Gold is held by Dyadia. If the target defeats/assists in defeating her, they will recover 100%/50% of the Gold respectively. She can use this skill again within 5s. If it is not used again, the cooldown will be reset."
      },
      {
        "skill_name": "Destined Encounter",
        "cd": "45s",
        "mana_cost": "100",
        "tags": [
          "Damage",
          "Heal"
        ],
        "description": "Dyadia commands a swarm of wisps to fly forward, granting fated bond to teammates in their path, restoring 250 (250 + 40% magical damage) Health, and inflicting bitter bond on enemies in their path, dealing 320 (320 + 40% magical damage) magical damage. If a teammate already has fated bond, the duration is refreshed. They also recover an extra 150 (150 + 25% magical damage) Health and gain 30% Movement Speed for 2s. If an enemy already has bitter bond, the duration is refreshed. They also take an extra 200 (200 + 30% magical damage) magical damage and are immobilized for 1s. Passive: Each time Dyadia gains 1 extra Gold from using a skill, the base Health restored and magical damage dealt from Destined Encounter are increased by 1."
      }
    ],
