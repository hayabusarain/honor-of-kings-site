{
  "581": {
    "name": "Flowborn (Tank)",
    "skills": [
      {
        "skill_name": "Flow of the World",
        "cd": "",
        "mana_cost": "",
        "tags": "Switch, Damage, Recovery",
        "description": "Flowborn can draw the Flow into their body at the Base to enhance stats. Vitality: Increases max Health by 300 and Physical and Magical Defense by 50. Piercing Heart: Increases max Health by 300 and Physical Attack by 30. Haste: Increases max Health by 300 and Movement Speed by 3.5%. Focus: Increases max Health by 300 and Cooldown Reduction by 5%. Spend 1 stack of Flow to perform an enhanced Basic Attack that deals 408 (220 + 100% AD + 4% extra max Health) physical damage and recover 125 (125 + 2.5% extra max Health) Health."
      },
      {
        "skill_name": "Convergence",
        "cd": "12.5s",
        "mana_cost": "45",
        "tags": "Enhance, Recovery, Knock Back",
        "description": "Flowborn channels the Flow, reducing the cooldown of other skills by 50% while gaining 5 stacks of Flow and recovering 150 (150 + 4% extra max Health) Health. Gains 1 extra stack and recovers extra Health for every teammate and every 2 minions nearby, for up to 9 stacks and double the recovery. Flowborn deals 100 (100 + 2% extra max Health) physical damage to nearby enemies and knocks them back (without applying crowd control)."
      },
      {
        "skill_name": "Power From Within",
        "cd": "7.5s",
        "mana_cost": "25",
        "tags": "Damage, Crowd Control, Shield",
        "description": "Flowborn charges toward the target, knocking back enemies in the path, then slashes forward to deal 600 (600 + 185% extra AD) physical damage and gain a 350 (350 + 7% extra max Health) shield for 3s. Using this skill continuously on the same target for 1.5s changes its effects in the following order. Clearing Slash: Deals equal slash damage to enemies, launches them for 0.33s, and gains a shield of the same amount. Rifting Slash: Deals equal slash damage to enemies, launches them for 0.66s, and gains a shield of the same amount. If the skill is not on cooldown, spend 4 stacks of Flow to stop it from entering cooldown after this use. All non-hero units within range of this skill are affected by the same crowd control effect."
      },
      {
        "skill_name": "All In",
        "cd": "25s",
        "mana_cost": "60",
        "tags": "Crowd Control, Damage",
        "description": "Flowborn leaps to the target location and attacks, dealing 400 (400 + 70% extra AD + 8% extra max Health) physical damage and knocking back enemies for 0.75s. Deals an extra 50% damage at the center of the attack. If the skill is not on cooldown, can spend 5 stacks of Flow to stop it from entering cooldown after this use."
      }
    ],
    "meta": {
      "summoner_spells": [
        "閃現",
        "処刑"
      ],
      "synergy": [
        {
          "hero_name": "后羿",
          "reason": "Acts as a frontline meatshield to peel for low-mobility marksmen against enemy dives.",
          "hero_id": "169"
        },
        {
          "hero_name": "諸葛亮",
          "reason": "Locks down multiple enemies with strong CC, allowing the mage to safely unleash massive AoE damage.",
          "hero_id": "190"
        }
      ],
      "counters": [
        {
          "hero_name": "マルコポーロ",
          "reason": "Can completely ignore the tank's high survivability with armor penetration and percentage-based damage.",
          "hero_id": "132"
        },
        {
          "hero_name": "呂布",
          "reason": "Possesses true damage that ignores shields and physical defense, making it impossible to tank.",
          "hero_id": "123"
        }
      ],
      "skill_order": {
        "primary_max": "Skill 1",
        "order": [
          "S1",
          "S2",
          "S1",
