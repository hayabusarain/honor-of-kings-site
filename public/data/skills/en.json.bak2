  "169": {
    "hero_name": "Hou Yi",
    "skills": [
      {
        "skill_name": "Passive Skill: Chastising Shot",
        "cd": "None",
        "mana_cost": "None",
        "tags": [
          "Enhance"
        ],
        "description": "Hou Yi gains 1 stack of Chastising Shot every time he hits an enemy with his Basic Attack, for up to 3 stacks. Each stack increases his Attack Speed by 2-4% for 3s. At max stacks, he becomes enhanced for 3s. While enhanced, his Basic Attacks shoot 3 arrows (counts as 1 Basic Attack), dealing a total of 120% of a normal Basic Attack's physical damage."
      },
      {
        "skill_name": "Skill 1: Arrow Volley",
        "cd": "10s",
        "mana_cost": "50",
        "tags": [
          "Enhance"
        ],
        "description": "Hou Yi enhances his Basic Attacks to deal 214 (90 + 75% physical attack) physical damage. While the Passive's enhancement is in effect, using Skill 1 will cause the 3 arrows to deal a total of 120% of a normal Basic Attack's physical damage plus 50% damage to 2 more enemies or structures in front of him within range (without on-hit effects). This effect lasts 5s."
      },
      {
        "skill_name": "Skill 2: Afterglow",
        "cd": "7s",
        "mana_cost": "40",
        "tags": [
          "Damage",
          "Slow",
          "Vision"
        ],
        "description": "Hou Yi orders the Sun Tower to attack the target area, gaining vision of the area. After a short delay, he deals 480 (480 + 110% extra physical attack) magical damage to enemies within range and reduces their Movement Speed by 25-50% for 2s. Damage and slow effects are halved against enemies on the edge of the skill's range."
      },
      {
        "skill_name": "Skill 3: Burning Sun Arrow",
        "cd": "45s",
        "mana_cost": "130",
        "tags": [
          "Crowd Control",
          "Slow",
          "Damage"
        ],
        "description": "Hou Yi shoots a flaming arrow in the target direction, which explodes upon hitting an enemy hero. The explosion deals 800 (800 + 120% extra physical attack) physical damage to enemies within range. The arrow stuns the first enemy hero hit for 0.75-3.5s (depending on how far it has flown), while slowing enemies in the explosion's range by 30% for 1s."
      }
    ],
    "meta": {
      "summoner_spells": [
        "閃現"
      ],
      "synergy": [
