        ],
        "description": "Haya unleashes a beam of moonlight forward, dealing 350 (350 + 75% magical attack) magical damage. If the beam triggers a mark, the target also takes 100 (100 + 22% magical attack) true damage."
      },
      {
        "skill_name": "Skill 2: Wayward Rays",
        "cd": "7s",
