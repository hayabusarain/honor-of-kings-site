  "514": {
    "hero_name": "Allain",
    "skills": [
      {
        "skill_name": "Passive Skill: Howling Blade",
        "cd": "None",
        "mana_cost": "None",
        "tags": [
          "Enhance",
          "Damage Reduction",
          "Damage"
        ],
        "description": "Allain's Basic Attack speed is very high. For each attack, he strikes once with each of his dual swords Crimson Shadow and Spirit Guardian, dealing 75 (22 + 30% AD) magical damage and 75 (22 + 30% AD) physical damage. Every first Basic Attack lets him dash to the target. Every third Basic Attack, he swings both swords at the same time, dealing 115 (36 + 45% AD) true damage and then entering a longer Basic Attack cooldown. When his Basic Attacks and skills hit enemy heroes, he gains Fury, increasing his Physical and Magical Pierce by up to 40% and damage reduction by up to 20%. Upon reaching max Fury, he recovers 168 (80 + 50% AD) Health, with a cooldown of 8s.\nThe lower his current Health, the more Health he recovers, for up to 3 times the base recovery.\nHis Physical Lifesteal takes 75% effect and applies to magical and true damage. His Basic Attacks only carry 60% of on-hit effects."
      },
      {
        "skill_name": "Skill 1: Meteor Kill",
        "cd": "5s",
        "mana_cost": "None",
        "tags": [
          "Immunity",
          "Crowd Control",
          "Damage"
        ],
        "description": "Allain swipes upward, dealing 177 (110 + 38% AD) magical damage, 177 (110 + 38% AD) physical damage twice, and launching targets directly in front of him for 0.75s. After the initial strikes of this skill, he performs different follow-up strikes depending on how many marks he has stacked.\n1 Mark: Strikes twice more, the first strike dealing 177 (110 + 38% AD) magical damage and the second strike dealing 177 (110 + 38% AD) physical damage.\n2 Marks: Increases the launch range and strikes another 2 times, the first strike dealing 177 (110 + 38% AD) magical damage and the second strike dealing 177 (110 + 38% AD) physical damage.\n3 Marks: Increases the launch range and strikes another 2 times, the first strike dealing 177 (110 + 38% AD) true damage and the second strike dealing 312 (180 + 75% AD) true damage.\nHe can move slowly and gains crowd control immunity while performing the strikes.\nHe gains stacks when his Ultimate and Basic Attacks hit enemies. Skill 1 can trigger 50% of the Basic Attack's on-hit effects, and can grant lifesteal and deal critical damage."
      },
      {
        "skill_name": "Skill 2: Moonlight Flash",
        "cd": "2s",
        "mana_cost": "None",
        "tags": [
          "Movement",
          "Damage",
          "Slow"
        ],
        "description": "Allain dashes in the target direction, dealing 144 (100 + 25% AD) physical damage and 144 (100 + 25% AD) magical damage to enemies in his path and reducing their Movement Speed by 15% for 1.5s. He also gains 10% Movement Speed for 3s, and his next 3 Basic Attacks gain 40% extra Attack Speed.\nHe stocks 1 charge of this skill every 10s (affected by Cooldown Reduction), for up to 2 charges."
      },
      {
        "skill_name": "Skill 3: Death at Sunset",
        "cd": "45s",
        "mana_cost": "None",
        "tags": [
          "Immunity",
          "Damage",
          "Shield"
        ],
        "description": "Allain selects a target hero and leaps into the air for 1.5s, during which he can move and is untargetable. He then smashes into the ground, dealing 254 (175 + 45% AD) physical damage and 254 (175 + 45% AD) magical damage to enemy heroes. The closer the heroes are to him, the more damage they take, for up to 100% extra damage. He gains marks and Fury for every enemy hero hit.\nThis skill produces different effects depending on whether the targeted hero is an enemy or a teammate. When he lands, he grants himself or the targeted teammate a shield that negates 627 (450 + 100% AD) damage. For every extra enemy hero hit, the shield's strength is increased by 1/3."
