  "118": {
    "hero_name": "Sun Bin",
    "skills": [
      {
        "skill_name": "Passive Skill: Fate's Guidance",
        "cd": "None",
        "mana_cost": "None",
        "tags": [
          "Damage"
        ],
        "description": "Heino engages in combat in either melee or ranged mode as fate dictates. His skills and melee Basic Attacks mark enemies for 7s on hit. Ranged: He channels the Power of Fate to attack distant enemies, dealing 165 (100% physical attack) physical damage and (15% magical attack) magical damage. Melee: He brandishes his scepter to attack all nearby enemies, dealing 165 (100% physical attack) physical damage and (45% magical attack) magical damage."
      },
      {
        "skill_name": "Skill 1: Scepter of Fate",
        "cd": "5s",
        "mana_cost": "30",
        "tags": [
          "Damage",
          "Recovery"
        ],
        "description": "Heino reduces his cooldown by 0.2s for each marked enemy hit, up to 1s. Ranged: He turns his scepter into energy and throws it, dealing 410 (410 + 75% magical attack) magical damage upon hit. He also throws 1 extra scepter at every marked enemy in front of him, dealing 75% damage. Melee: He throws his scepter spinning, dealing 260 (260 + 45% magical attack) magical damage to enemies in its path and slowing them by 15% for 2s. He recovers 150 (150 + 5% extra max health) Health for each target hit. Ranged: When extra scepters hit the same target multiple times, subsequent hits only deal 50% of the initial damage. Melee: Recovers Health up to 3 times."
      },
      {
        "skill_name": "Skill 2: Leap of Fate",
        "cd": "6s",
        "mana_cost": "40",
        "tags": [
          "Dash",
          "Recovery",
          "Switch Form"
        ],
        "description": "Heino dashes forward. If there are no enemy heroes near the end of the dash, he goes into ranged mode. Otherwise, he goes into melee mode. Ranged: Gains 15% Movement Speed for 2s. For each enemy hero near the starting point of the dash, his Movement Speed increases by 25%, up to 50%. If Skill 2 causes him to switch from melee to ranged mode, both the Movement Speed increase and its limit are doubled. Melee: Gains 100 physical defense and magical defense, and recovers 450 (450 + 12% extra max health) Health while increasing max health by the same amount. For each enemy hero near the endpoint of the dash, his Health recovery increases by 25%, up to 50%. If Skill 2 causes him to switch from ranged to melee mode, both the Health recovery and its limit are doubled."
      },
      {
        "skill_name": "Skill 3: Fate Rewind",
        "cd": "80s",
        "mana_cost": "80",
        "tags": [
          "Retrace",
          "Damage",
          "Recovery"
        ],
        "description": "Heino leaves behind a memory whenever he changes to ranged mode. He creates a field that grants 15% damage reduction and recovers 400 (400 + 6% extra max health) Health. During this time, he has crowd control immunity but cannot move. After a 1.5s delay, the field deals 400 (400 + 100% magical attack) magical damage and he returns to the memory he left behind. If there is an allied tower within the field, that tower returns to its state from 5s earlier. The lower his Health, the more Health he recovers, up to 2 times the base value."
      }
    ],
