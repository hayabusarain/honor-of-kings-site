  "501": {
    "hero_name": "Ming",
    "skills": [
      {
        "skill_name": "Good Omens",
        "cd": "0",
        "mana_cost": "0",
        "tags": "Heal, Damage",
        "description": "Every 5s, the next Basic Attack deals 238 (70 + 100% physical attack + 20% magical attack) magical damage and steals Health from the hit enemy, restoring 225 (225 + 40% magical attack) Health to the linked teammate and to Ming. Ming additionally recovers 4% extra Health.\nHitting a non-hero enemy unit only restores 50% Health."
      },
      {
        "skill_name": "Time - Carefree",
        "cd": "5s",
        "mana_cost": "40",
        "tags": "Enhance, Damage",
        "description": "Ming throws his instrument. If it hits a teammate, it links to them. If it misses, it automatically links to a teammate within range. The instrument increases the linked teammate's main attack stat by 20 (20 + 10% magical attack) (1 main attack stat = 1 physical attack or 2 magical attack) and their Attack Speed by 10%. If the instrument hits a teammate, increases the main attack stat boost by an extra 25% (rapidly diminishes over 4s).\nEnemies who touch the link take 30 (30 + 25% magical attack) magical damage every 0.5s.\nPassive: Increases his physical attack by 30, magical attack by 65, and Movement Speed by 7.5%."
      },
      {
        "skill_name": "Mastery - Glide",
        "cd": "5s",
        "mana_cost": "40",
        "tags": "Enfeeble, Damage",
        "description": "Ming throws his instrument. If it hits an enemy hero, it links to them. If it misses, it automatically links to an enemy hero within range. The instrument reduces the linked enemy's physical defense and magical defense by 10%. If the instrument hits an enemy hero, it reduces their physical defense and magical defense by an extra 25% (rapidly diminishes over 4s).\nEnemies who touch the link take 30 (30 + 25% magical attack) magical damage every 0.5s.\nPassive: Increases his physical defense and magical defense by 15%."
      },
      {
        "skill_name": "Peace - Longevity",
        "cd": "40s",
        "mana_cost": "120",
        "tags": "Heal, Damage",
        "description": "After channeling for 0.75s, Ming deals true damage to an enemy linked to his instrument and restores Health to a linked teammate.\nIf the instrument is linked to 1 target, Ming spends 600 (600 + 125% magical attack) of his own Health to deal an equal amount of true damage to the target if it's an enemy, or to restore an equal amount of Health if it's a teammate.\nIf the instrument is linked to 2 targets, Ming steals 600 (600 + 125% magical attack) Health from the enemy and gives it to the teammate.\nIf the targets die before Ming finishes channeling, 70% of the cooldown is returned. The Health spent is slowly restored over 5s."
      }
    ],
    "meta": {
